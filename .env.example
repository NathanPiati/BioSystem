# Copie este arquivo para .env no servidor antes do deploy.
# IMPORTANTE: no Docker Compose, $ na chave vira variavel. Use $$ ou gere chave sem $.

DJANGO_SECRET_KEY=troque-por-uma-chave-segura-sem-cifrão
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.inovacore.api.br,inovacore.api.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.inovacore.api.br,https://inovacore.api.br,http://www.inovacore.api.br:8001,http://inovacore.api.br:8001

# Informacoes exibidas no rodape do sistema
APP_VERSION=1.0.0
SUPPORT_CONTACT=Para duvidas ou abertura de chamados, entre em contato com o administrador do sistema.

# Banco — com docker-compose.yml, DB_HOST deve ser "postgres" (nome do servico)
DB_NAME=AcademiaDB
DB_USER=biosystem_user
DB_PASSWORD=sua_senha_aqui
DB_HOST=postgres
DB_PORT=5432

# Evolution API — usada para enviar a ficha de treino pelo WhatsApp
EVOLUTION_API_URL=https://seu-servidor-evolution.example.com
EVOLUTION_API_KEY=sua-chave-da-evolution-api
EVOLUTION_API_INSTANCE=nome-da-instancia

# Asaas Sandbox — token configurado no webhook
ASAAS_WEBHOOK_TOKEN=troque-pelo-token-do-webhook
ASAAS_API_KEY=chave-do-asaas-sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_MONTHLY_VALUE=49.90
ASAAS_BILLING_TYPE=PIX
ASAAS_SUBSCRIPTION_DESCRIPTION=Assinatura mensal Evolutty

# Se o PostgreSQL ja existir FORA do Docker, use o IP do servidor em DB_HOST
# Exemplo Linux: DB_HOST=172.17.0.1  ou  IP_interno_do_postgres
