# Copie este arquivo para .env no servidor antes do deploy.
# IMPORTANTE: no Docker Compose, $ na chave vira variavel. Use $$ ou gere chave sem $.

DJANGO_SECRET_KEY=troque-por-uma-chave-segura-sem-cifrão
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.inovacore.api.br,inovacore.api.br

# Banco — com docker-compose.yml, DB_HOST deve ser "postgres" (nome do servico)
DB_NAME=AcademiaDB
DB_USER=biosystem_user
DB_PASSWORD=sua_senha_aqui
DB_HOST=postgres
DB_PORT=5432

# Se o PostgreSQL ja existir FORA do Docker, use o IP do servidor em DB_HOST
# Exemplo Linux: DB_HOST=172.17.0.1  ou  IP_interno_do_postgres
